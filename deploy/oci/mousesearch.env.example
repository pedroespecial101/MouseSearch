# Copy this file to /opt/appdata/mousesearch/.env on pedroserve02-A1.
# Keep the real file server-local. Do not commit secrets.

TZ=Europe/London
# Set these to the actual host user/group that should own MouseSearch data.
# On pedroserve02-A1, ubuntu is 1001:1001 (`id ubuntu`).
PUID=1001
PGID=1001

# Tailscale sidecar
TS_AUTHKEY=tskey-example-replace-me
TS_HOSTNAME=mousesearch

# MouseSearch app
QUART_SECRET_KEY=replace-with-openssl-rand-hex-32
MAM_ID=replace-with-your-mam-id
TORRENT_CLIENT_TYPE=qbittorrent
# Prefer a Tailscale IP or other address resolvable from inside the container.
# Do not include a trailing slash.
TORRENT_CLIENT_URL=http://100.85.214.86:18080
TORRENT_CLIENT_USERNAME=replace-me
TORRENT_CLIENT_PASSWORD=replace-me
TORRENT_CLIENT_CATEGORY=audiobooks
QB_FORCE_START=false
APP_LOG_LEVEL=INFO
ACCESS_LOGFILE=/dev/null

# Optional HTTP MCP sidecar/profile
MOUSESEARCH_API_BASE_URL=http://127.0.0.1:5000/api/v1
MOUSESEARCH_API_TOKEN=
MOUSESEARCH_MCP_PORT=8765
